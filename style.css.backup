/* =========================================================
   NEXORA AI — COMPLETE UI
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
}

body {
    background: #050914;
    color: #e8ecf7;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
        Helvetica, Arial, sans-serif;
    overflow: hidden;
}


/* =========================================================
   MAIN APP
========================================================= */

.app,
#app,
.app-container {
    width: 100%;
    height: 100%;
}


/* =========================================================
   HEADER
========================================================= */

.header {
    position: relative;
    z-index: 20;
    width: 100%;
    min-height: 72px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(5, 9, 20, 0.94);
    border-bottom: 1px solid #151d31;
    backdrop-filter: blur(16px);
}

.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 11px;
}

.logo-icon {
    width: 43px;
    height: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: linear-gradient(135deg, #4169ff, #6538ff);
    color: white;
    font-size: 21px;
    font-weight: 800;
    box-shadow: 0 8px 25px rgba(65, 80, 255, 0.22);
}

.logo-text h1 {
    margin: 0;
    color: #f2f4fb;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 1.4px;
    line-height: 1;
}

.logo-text p {
    margin: 5px 0 0;
    color: #626d88;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 2px;
}

.verification-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    margin-left: 3px;
    border-radius: 50%;
    background: #3f72ff;
    color: white;
    font-size: 9px;
    vertical-align: 2px;
}


/* =========================================================
   HEADER ACTIONS
========================================================= */

.header-actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

.status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #8993ac;
    font-size: 11px;
    font-weight: 600;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #35d98b;
    box-shadow: 0 0 10px rgba(53, 217, 139, 0.65);
}

.profile-button,
.clear-button {
    height: 40px;
    border: 1px solid #1b253b;
    border-radius: 11px;
    background: #0a1020;
    color: #cbd2e4;
    cursor: pointer;
    transition: 0.18s ease;
}

.profile-button {
    width: 40px;
    font-size: 17px;
}

.clear-button {
    padding: 0 13px;
    font-size: 12px;
    font-weight: 600;
}

.profile-button:hover,
.clear-button:hover {
    background: #111a2e;
    border-color: #2a395d;
}

.profile-button:active,
.clear-button:active {
    transform: scale(0.96);
}


/* =========================================================
   CHAT AREA
========================================================= */

.chat-container {
    position: relative;
    width: 100%;
    height: calc(100% - 72px);
    display: flex;
    flex-direction: column;
    background:
        radial-gradient(circle at 50% 15%, rgba(49, 74, 170, 0.08), transparent 34%),
        #050914;
}


/* =========================================================
   CHAT BOX
========================================================= */

.chat-box {
    flex: 1;
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 34px 22px 20px;
    overflow-y: auto;
    scroll-behavior: smooth;
}

.chat-box::-webkit-scrollbar {
    width: 5px;
}

.chat-box::-webkit-scrollbar-thumb {
    background: #1b253d;
    border-radius: 10px;
}

.chat-box::-webkit-scrollbar-track {
    background: transparent;
}


/* =========================================================
   WELCOME MESSAGE
========================================================= */

.welcome-message {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 35px 15px 80px;
    text-align: center;
}

.welcome-message .avatar,
.welcome-message .bot-avatar {
    width: 58px;
    height: 58px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, #4169ff, #6538ff);
    color: white;
    font-size: 25px;
    font-weight: 800;
    box-shadow: 0 12px 35px rgba(65, 80, 255, 0.22);
}

.welcome-message h2 {
    margin: 0;
    color: #f0f3fa;
    font-size: 24px;
    font-weight: 750;
}

.welcome-message p {
    max-width: 480px;
    margin: 10px auto 0;
    color: #727d97;
    font-size: 14px;
    line-height: 1.65;
}


/* =========================================================
   MESSAGE BUBBLES
========================================================= */

.message {
    display: flex;
    width: 100%;
    margin: 0 auto 20px;
}

.message.user {
    justify-content: flex-end;
}

.message.assistant {
    justify-content: flex-start;
}

.message-content {
    max-width: min(78%, 700px);
    padding: 13px 16px;
    border-radius: 17px;
    font-size: 14px;
    line-height: 1.65;
    word-wrap: break-word;
}

.message.user .message-content {
    background: linear-gradient(135deg, #4169ff, #5539df);
    color: white;
    border-bottom-right-radius: 5px;
    box-shadow: 0 8px 25px rgba(55, 65, 220, 0.18);
}

.message.assistant .message-content {
    background: #0c1324;
    border: 1px solid #18233b;
    color: #d8deec;
    border-bottom-left-radius: 5px;
}


/* =========================================================
   INPUT AREA
========================================================= */

.input-area {
    flex-shrink: 0;
    width: 100%;
    padding: 10px 18px 9px;
    background: linear-gradient(
        to top,
        #050914 72%,
        rgba(5, 9, 20, 0)
    );
}

.input-wrapper {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px 7px 15px;
    background: #0b1222;
    border: 1px solid #1b2741;
    border-radius: 18px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
    transition: 0.2s ease;
}

.input-wrapper:focus-within {
    border-color: #30467d;
    box-shadow:
        0 0 0 3px rgba(65, 105, 255, 0.08),
        0 12px 35px rgba(0, 0, 0, 0.25);
}

#messageInput,
.message-input {
    flex: 1;
    min-width: 0;
    height: 42px;
    padding: 0;
    border: none;
    outline: none;
    resize: none;
    background: transparent;
    color: #e8edf8;
    font-family: inherit;
    font-size: 14px;
}

#messageInput::placeholder,
.message-input::placeholder {
    color: #5f6a84;
}


/* =========================================================
   SEND / VOICE BUTTONS
========================================================= */

.voice-button,
.send-button {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 13px;
    cursor: pointer;
    transition: 0.18s ease;
}

.voice-button {
    background: #111a2e;
    color: #aeb8ce;
    font-size: 17px;
}

.send-button {
    background: linear-gradient(135deg, #4169ff, #6538ff);
    color: white;
    font-size: 17px;
    box-shadow: 0 6px 18px rgba(65, 80, 255, 0.2);
}

.voice-button:hover {
    background: #18233b;
    color: white;
}

.send-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(65, 80, 255, 0.3);
}

.voice-button:active,
.send-button:active {
    transform: scale(0.94);
}


/* =========================================================
   VOICE REPLIES
========================================================= */

.voice-reply {
    max-width: 920px;
    margin: 9px auto 0;
    padding: 0 3px;
    display: flex;
    align-items: center;
    gap: 7px;
    color: #707b95;
    font-size: 11px;
}

.voice-reply input {
    accent-color: #4169ff;
}


/* =========================================================
   DISCLAIMER
========================================================= */

.disclaimer {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 6px 5px 3px;
    color: #4f5a72;
    font-size: 9px;
    line-height: 1.4;
    text-align: center;
}


/* =========================================================
   PROFILE PANEL
========================================================= */

.profile-panel {
    position: fixed;
    top: 76px;
    right: 16px;
    z-index: 70;
    width: 280px;
    max-width: calc(100vw - 32px);
    padding: 18px;
    border: 1px solid #202b45;
    border-radius: 16px;
    background: #0a1020;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
}


/* =========================================================
   NEXORA SIDE DRAWER
========================================================= */

.menu-button {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid #1d263c;
    border-radius: 13px;
    background: #080d19;
    color: #d9def0;
    font-size: 21px;
    cursor: pointer;
    transition: 0.2s ease;
}

.menu-button:hover {
    background: #111a2e;
    border-color: #33416a;
}

.menu-button:active {
    transform: scale(0.94);
}


/* =========================================================
   DRAWER OVERLAY
========================================================= */

.drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition: 0.25s ease;
    z-index: 90;
}

.drawer-overlay.active {
    opacity: 1;
    visibility: visible;
}


/* =========================================================
   SIDE DRAWER
========================================================= */

.side-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 320px;
    max-width: 88vw;
    display: flex;
    flex-direction: column;
    padding: 18px;
    background: #080d19;
    border-right: 1px solid #202a44;
    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.45);
    transform: translateX(-105%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 100;
}

.side-drawer.open {
    transform: translateX(0);
}


/* =========================================================
   DRAWER HEADER
========================================================= */

.drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid #171f34;
}

.drawer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.drawer-logo {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, #4169ff, #6538ff);
    font-size: 22px;
    font-weight: 800;
    box-shadow: 0 7px 25px rgba(70, 70, 255, 0.25);
}

.drawer-brand strong {
    display: block;
    font-size: 14px;
    letter-spacing: 1.5px;
}

.drawer-brand span {
    display: block;
    margin-top: 3px;
    color: #59627d;
    font-size: 8px;
    letter-spacing: 1.5px;
}

.drawer-close {
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 11px;
    background: #10172a;
    color: #929ab2;
    font-size: 17px;
    cursor: pointer;
}

.drawer-close:hover {
    background: #18213a;
    color: white;
}


/* =========================================================
   NEW CHAT
========================================================= */

.new-chat-button {
    width: 100%;
    height: 52px;
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid #4b5cff;
    border-radius: 14px;
    background: linear-gradient(135deg, #4169ff, #6538ff);
    color: white;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(65, 75, 255, 0.18);
}

.new-chat-button span {
    font-size: 23px;
    line-height: 1;
}

.new-chat-button:active {
    transform: scale(0.98);
}


/* =========================================================
   CONVERSATION SECTION
========================================================= */

.drawer-section-title {
    margin: 25px 5px 10px;
    color: #5f6985;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-transform: uppercase;
}

.conversation-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-right: 3px;
}

.conversation-list::-webkit-scrollbar {
    width: 4px;
}

.conversation-list::-webkit-scrollbar-thumb {
    background: #202945;
    border-radius: 10px;
}


/* =========================================================
   CONVERSATION ITEM
========================================================= */

.conversation-item {
    position: relative;
    width: 100%;
    min-height: 58px;
    margin-bottom: 5px;
    padding: 10px 42px 10px 13px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: #cdd3e5;
    cursor: pointer;
    transition: 0.18s ease;
}

.conversation-item:hover {
    background: #10172a;
    border-color: #1c2740;
}

.conversation-item.active {
    background: #121b34;
    border-color: #293866;
}

.conversation-title {
    overflow: hidden;
    color: #dce1ef;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.conversation-date {
    margin-top: 4px;
    color: #626d88;
    font-size: 10px;
}

.delete-conversation {
    position: absolute;
    top: 50%;
    right: 8px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: #65708b;
    font-size: 14px;
    cursor: pointer;
    transform: translateY(-50%);
}

.delete-conversation:hover {
    background: #27131c;
    color: #ff718b;
}


/* =========================================================
   LOADING / EMPTY
========================================================= */

.conversation-loading,
.conversation-empty {
    padding: 25px 10px;
    text-align: center;
    color: #606b86;
    font-size: 12px;
    line-height: 1.6;
}


/* =========================================================
   DRAWER BOTTOM
========================================================= */

.drawer-bottom {
    flex-shrink: 0;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid #171f34;
}

.drawer-menu-button {
    width: 100%;
    height: 50px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: #cdd3e5;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
}

.drawer-menu-button:hover {
    background: #10172a;
    border-color: #1c2740;
}

.drawer-menu-icon {
    width: 30px;
    text-align: center;
    font-size: 19px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

    .header {
        min-height: 66px;
        padding: 10px 12px;
    }

    .chat-container {
        height: calc(100% - 66px);
    }

    .logo-icon {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        font-size: 19px;
    }

    .logo-text h1 {
        font-size: 15px;
    }

    .status {
        display: none;
    }

    .clear-button {
        height: 38px;
    }

    .profile-button {
        width: 38px;
        height: 38px;
    }

    .chat-box {
        padding: 24px 14px 16px;
    }

    .welcome-message {
        padding: 20px 10px 65px;
    }

    .welcome-message .avatar,
    .welcome-message .bot-avatar {
        width: 54px;
        height: 54px;
        margin-bottom: 15px;
    }

    .welcome-message h2 {
        font-size: 21px;
    }

    .welcome-message p {
        font-size: 13px;
    }

    .message-content {
        max-width: 88%;
        font-size: 13.5px;
    }

    .input-area {
        padding: 8px 10px 7px;
    }

    .input-wrapper {
        padding-left: 13px;
        border-radius: 16px;
    }

    #messageInput,
    .message-input {
        font-size: 13.5px;
    }

    .voice-button,
    .send-button {
        width: 40px;
        height: 40px;
    }

    .voice-reply {
        padding-left: 3px;
        font-size: 10px;
    }

    .disclaimer {
        font-size: 8px;
        padding-bottom: 2px;
    }

    .side-drawer {
        width: 305px;
        padding: 15px;
    }

    .menu-button {
        width: 42px;
        height: 42px;
        font-size: 20px;
    }

    .header-left {
        gap: 8px;
    }
}


/* =========================================================
   SMALL PHONE
========================================================= */

@media (max-width: 380px) {

    .side-drawer {
        width: 290px;
    }

    .menu-button {
        width: 40px;
        height: 40px;
    }

    .clear-button {
        padding: 0 10px;
        font-size: 11px;
    }

    .chat-box {
        padding-left: 10px;
        padding-right: 10px;
    }

    .message-content {
        max-width: 92%;
    }

}